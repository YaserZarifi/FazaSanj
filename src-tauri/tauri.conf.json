{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fazasanj",
  "version": "0.1.0",
  "identifier": "com.yaserzarifi.fazasanj",
  "build": {
    "beforeDevCommand": "node scripts/copy-sidecar.mjs debug && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/copy-sidecar.mjs release && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fazasanj",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Yaser Zarifi",
    "copyright": "Copyright (c) 2026 Yaser Zarifi",
    "category": "Utility",
    "shortDescription": "Find out where your disk space went",
    "longDescription": "Fazasanj scans your drives, explains what is using the space, tells you what is safe to remove and what happens if you remove it.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "Persian"
        ],
        "displayLanguageSelector": true,
        "installMode": "both"
      }
    },
    "externalBin": [
      "binaries/fast-scan-helper"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFDQjI3OTZDREVERThCMjYKUldRbWk5N2ViSG15SExMRjJzT3V3bjJ2RU12YU5vaFA1akduOWlyS1U3VnFzRzJlT2U4YXVkWEgK",
      "endpoints": [
        "https://github.com/YaserZarifi/FazaSanj/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}